diff --git a/contrib/pgvector/bench/run_ivfflat_high_probes.sh b/contrib/pgvector/bench/run_ivfflat_high_probes.sh
new file mode 100755
index 0000000000000000000000000000000000000000..8538bf3de02514654e999d3c8fd9981136b78db0
--- /dev/null
+++ b/contrib/pgvector/bench/run_ivfflat_high_probes.sh
@@ -0,0 +1,216 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
+RESULT_DIR="${RESULT_DIR:-${SCRIPT_DIR}/results/ivfflat_high_probes_$(date +%Y%m%d_%H%M%S)}"
+
+DBNAME="${DBNAME:-ivfflat_test}"
+WORK_MEM="${WORK_MEM:-4MB}"
+QUERY_WORK_MEM="${QUERY_WORK_MEM:-64MB}"
+PROBES="${PROBES:-1000}"
+REPETITIONS="${REPETITIONS:-5}"
+PROFILE_ITEMS="${PROFILE_ITEMS:-profile_items}"
+PROFILE_QUERIES="${PROFILE_QUERIES:-profile_queries}"
+RUN_CORRECTNESS="${RUN_CORRECTNESS:-true}"
+RUN_MATRIX="${RUN_MATRIX:-true}"
+
+PSQL=(psql -X -v ON_ERROR_STOP=1 -d "$DBNAME")
+AGGREGATE_OUTPUT="${RESULT_DIR}/aggregate.csv"
+CORRECTNESS_OUTPUT="${RESULT_DIR}/correctness.txt"
+
+require_positive_integer() {
+	local name="$1"
+	local value="$2"
+
+	case "$value" in
+		''|*[!0-9]*)
+			echo "${name} must be a positive integer: ${value}" >&2
+			exit 2
+			;;
+	esac
+
+	if [ "$value" -le 0 ]; then
+		echo "${name} must be greater than zero: ${value}" >&2
+		exit 2
+	fi
+}
+
+validate_identifier() {
+	local name="$1"
+	local value="$2"
+
+	if ! [[ "$value" =~ ^[a-zA-Z_][a-zA-Z0-9_]*$ ]]; then
+		echo "${name} must be an unqualified SQL identifier: ${value}" >&2
+		exit 2
+	fi
+}
+
+run_plan() {
+	local variant="$1"
+	local rep="$2"
+	local sort_mem="$3"
+	local output_dir="${RESULT_DIR}/${variant}"
+	local output_file="${output_dir}/${variant}_rep${rep}.txt"
+	local execution_time temp_read temp_written index_loops
+
+	mkdir -p "$output_dir"
+	"${PSQL[@]}" > "$output_file" <<SQL
+LOAD 'vector';
+SET work_mem = '${WORK_MEM}';
+SET max_parallel_workers_per_gather = 0;
+SET enable_seqscan = off;
+SET ivfflat.probes = ${PROBES};
+SET ivfflat.iterative_scan = off;
+SET ivfflat.query_work_mem = '${sort_mem}';
+EXPLAIN (ANALYZE, BUFFERS, COSTS OFF)
+SELECT count(*)
+FROM ${PROFILE_QUERIES} q
+CROSS JOIN LATERAL (
+	SELECT i.id
+	FROM ${PROFILE_ITEMS} i
+	ORDER BY i.embedding <=> q.embedding
+	LIMIT 10
+) nearest;
+SQL
+
+	execution_time="$(awk '/Execution Time:/ { print $(NF - 1); exit }' "$output_file")"
+	read -r temp_read temp_written < <(
+		awk '
+			/Buffers:.*temp read=/ {
+				for (i = 1; i <= NF; i++) {
+					if ($i ~ /^read=/) { split($i, a, "="); read = a[2] }
+					if ($i ~ /^written=/) { split($i, a, "="); written = a[2] }
+				}
+				exit
+			}
+			END { printf "%d %d\n", read + 0, written + 0 }
+		' "$output_file"
+	)
+	index_loops="$(
+		grep -E 'Index Scan using profile_items_cos_idx.*loops=[0-9]+' "$output_file" |
+			sed -E 's/.*loops=([0-9]+).*/\1/' | head -n 1
+	)"
+
+	if [ -z "$execution_time" ] || [ "${index_loops:-0}" -ne 200 ]; then
+		echo "invalid plan evidence in ${output_file}" >&2
+		exit 1
+	fi
+
+	printf '%s,%s,%s,%s,%s,%s\n' \
+		"$variant" "$rep" "$execution_time" "$temp_read" "$temp_written" "$index_loops" \
+		>> "$AGGREGATE_OUTPUT"
+}
+
+run_correctness() {
+	local exact_output="${RESULT_DIR}/exact_top10.csv"
+	local ivfflat_output="${RESULT_DIR}/ivfflat_top10.csv"
+	local exact_sorted="${RESULT_DIR}/exact_top10.sorted.csv"
+	local ivfflat_sorted="${RESULT_DIR}/ivfflat_top10.sorted.csv"
+	local exact_rows ivfflat_rows matching_rows differing_rows recall
+
+	"${PSQL[@]}" -qAt -F, > "$exact_output" <<SQL
+LOAD 'vector';
+SET work_mem = '${WORK_MEM}';
+SET max_parallel_workers_per_gather = 0;
+SET ivfflat.iterative_scan = off;
+SET enable_indexscan = off;
+SET enable_bitmapscan = off;
+SELECT q.id, nearest.id
+FROM ${PROFILE_QUERIES} q
+CROSS JOIN LATERAL (
+	SELECT i.id
+	FROM ${PROFILE_ITEMS} i
+	ORDER BY i.embedding <=> q.embedding
+	LIMIT 10
+) nearest;
+SQL
+
+	"${PSQL[@]}" -qAt -F, > "$ivfflat_output" <<SQL
+LOAD 'vector';
+SET work_mem = '${WORK_MEM}';
+SET max_parallel_workers_per_gather = 0;
+SET ivfflat.iterative_scan = off;
+SET enable_seqscan = off;
+SET enable_indexscan = on;
+SET ivfflat.probes = ${PROBES};
+SET ivfflat.query_work_mem = '${QUERY_WORK_MEM}';
+SELECT q.id, nearest.id
+FROM ${PROFILE_QUERIES} q
+CROSS JOIN LATERAL (
+	SELECT i.id
+	FROM ${PROFILE_ITEMS} i
+	ORDER BY i.embedding <=> q.embedding
+	LIMIT 10
+) nearest;
+SQL
+
+	LC_ALL=C sort "$exact_output" > "$exact_sorted"
+	LC_ALL=C sort "$ivfflat_output" > "$ivfflat_sorted"
+	exact_rows="$(wc -l < "$exact_sorted" | tr -d ' ')"
+	ivfflat_rows="$(wc -l < "$ivfflat_sorted" | tr -d ' ')"
+	matching_rows="$(LC_ALL=C comm -12 "$exact_sorted" "$ivfflat_sorted" | wc -l | tr -d ' ')"
+	differing_rows="$(LC_ALL=C comm -3 "$exact_sorted" "$ivfflat_sorted" | wc -l | tr -d ' ')"
+	recall="$(awk -v matches="$matching_rows" -v total="$exact_rows" \
+		'BEGIN { if (total == 0) print "0.000000"; else printf "%.6f\n", matches / total }')"
+	{
+		printf 'exact_rows=%s\n' "$exact_rows"
+		printf 'ivfflat_rows=%s\n' "$ivfflat_rows"
+		printf 'matching_rows=%s\n' "$matching_rows"
+		printf 'differing_rows=%s\n' "$differing_rows"
+		printf 'recall_at_10=%s\n' "$recall"
+	} > "$CORRECTNESS_OUTPUT"
+
+	if [ "$exact_rows" -ne 2000 ] || [ "$ivfflat_rows" -ne 2000 ] ||
+		[ "$matching_rows" -ne 2000 ] || [ "$differing_rows" -ne 0 ]; then
+		echo "top-10 correctness check failed; see ${CORRECTNESS_OUTPUT}" >&2
+		exit 1
+	fi
+}
+
+require_positive_integer "PROBES" "$PROBES"
+require_positive_integer "REPETITIONS" "$REPETITIONS"
+validate_identifier "PROFILE_ITEMS" "$PROFILE_ITEMS"
+validate_identifier "PROFILE_QUERIES" "$PROFILE_QUERIES"
+
+for setting in "RUN_MATRIX:${RUN_MATRIX}" "RUN_CORRECTNESS:${RUN_CORRECTNESS}"; do
+	case "${setting#*:}" in
+		true|false) ;;
+		*)
+			echo "${setting%%:*} must be true or false: ${setting#*:}" >&2
+			exit 2
+			;;
+	esac
+done
+
+if [ "$RUN_MATRIX" = false ] && [ "$RUN_CORRECTNESS" = false ]; then
+	echo "RUN_MATRIX and RUN_CORRECTNESS cannot both be false" >&2
+	exit 2
+fi
+
+mkdir -p "$RESULT_DIR"
+if [ "$RUN_MATRIX" = true ]; then
+	printf '%s\n' 'variant,rep,execution_time_ms,temp_read_blocks,temp_written_blocks,index_loops' \
+		> "$AGGREGATE_OUTPUT"
+
+	# ABBA order limits bias from temperature and cache drift without changing the workload.
+	for rep in $(seq 1 "$REPETITIONS"); do
+		if [ $((rep % 2)) -eq 1 ]; then
+			run_plan inherit_work_mem "$rep" 0
+			run_plan query_work_mem_64mb "$rep" "$QUERY_WORK_MEM"
+		else
+			run_plan query_work_mem_64mb "$rep" "$QUERY_WORK_MEM"
+			run_plan inherit_work_mem "$rep" 0
+		fi
+	done
+fi
+
+if [ "$RUN_CORRECTNESS" = true ]; then
+	run_correctness
+fi
+
+if [ "$RUN_MATRIX" = true ]; then
+	echo "aggregate: $AGGREGATE_OUTPUT"
+fi
+if [ "$RUN_CORRECTNESS" = true ]; then
+	echo "correctness: $CORRECTNESS_OUTPUT"
+fi
diff --git a/contrib/pgvector/bench/run_ivfflat_perf_profile.sh b/contrib/pgvector/bench/run_ivfflat_perf_profile.sh
new file mode 100755
index 0000000000000000000000000000000000000000..b5dcd0b21e7644bc40d6f0fa6a70dd76a5878e8b
--- /dev/null
+++ b/contrib/pgvector/bench/run_ivfflat_perf_profile.sh
@@ -0,0 +1,119 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+DBNAME="${DBNAME:-ivfflat_test}"
+WORK_MEM="${WORK_MEM:-4MB}"
+QUERY_WORK_MEM="${QUERY_WORK_MEM:-0}"
+PROBES="${PROBES:-1000}"
+PROFILE_ITEMS="${PROFILE_ITEMS:-profile_items}"
+PROFILE_QUERIES="${PROFILE_QUERIES:-profile_queries}"
+RESULT_DIR="${RESULT_DIR:-ivfflat_perf_$(date +%Y%m%d_%H%M%S)}"
+PERF_SECONDS="${PERF_SECONDS:-30}"
+APPNAME="ivfflat_perf_${$}"
+
+PSQL=(psql -X -v ON_ERROR_STOP=1 -d "$DBNAME")
+CLIENT_PID=""
+
+cleanup() {
+	if [ -n "$CLIENT_PID" ] && kill -0 "$CLIENT_PID" 2>/dev/null; then
+		kill "$CLIENT_PID" 2>/dev/null || true
+	fi
+}
+trap cleanup EXIT INT TERM
+
+validate_identifier() {
+	local name="$1"
+	local value="$2"
+
+	if ! [[ "$value" =~ ^[a-zA-Z_][a-zA-Z0-9_]*$ ]]; then
+		echo "${name} must be an unqualified SQL identifier: ${value}" >&2
+		exit 2
+	fi
+}
+
+for setting in "PROBES:${PROBES}" "PERF_SECONDS:${PERF_SECONDS}"; do
+	case "${setting#*:}" in
+		''|*[!0-9]*)
+			echo "${setting%%:*} must be a positive integer: ${setting#*:}" >&2
+			exit 2
+			;;
+	esac
+	if [ "${setting#*:}" -le 0 ]; then
+		echo "${setting%%:*} must be greater than zero" >&2
+		exit 2
+	fi
+done
+validate_identifier "PROFILE_ITEMS" "$PROFILE_ITEMS"
+validate_identifier "PROFILE_QUERIES" "$PROFILE_QUERIES"
+command -v perf >/dev/null || { echo "perf is required" >&2; exit 2; }
+
+mkdir -p "$RESULT_DIR"
+PGAPPNAME="$APPNAME" "${PSQL[@]}" > "${RESULT_DIR}/workload.log" 2>&1 <<SQL &
+LOAD 'vector';
+SET work_mem = '${WORK_MEM}';
+SET max_parallel_workers_per_gather = 0;
+SET enable_seqscan = off;
+SET ivfflat.probes = ${PROBES};
+SET ivfflat.iterative_scan = off;
+SET ivfflat.query_work_mem = '${QUERY_WORK_MEM}';
+EXPLAIN (ANALYZE, BUFFERS, COSTS OFF)
+SELECT count(*)
+FROM ${PROFILE_QUERIES} q
+CROSS JOIN LATERAL (
+	SELECT i.id
+	FROM ${PROFILE_ITEMS} i
+	ORDER BY i.embedding <=> q.embedding
+	LIMIT 10
+) nearest;
+SQL
+CLIENT_PID=$!
+
+BACKEND_PID=""
+for _ in $(seq 1 100); do
+	BACKEND_PID="$("${PSQL[@]}" -Atqc \
+		"SELECT pid FROM pg_stat_activity WHERE application_name = '${APPNAME}' LIMIT 1" || true)"
+	if [[ "$BACKEND_PID" =~ ^[0-9]+$ ]]; then
+		break
+	fi
+	if ! kill -0 "$CLIENT_PID" 2>/dev/null; then
+		break
+	fi
+	sleep 0.1
+done
+
+if ! [[ "$BACKEND_PID" =~ ^[0-9]+$ ]]; then
+	set +e
+	wait "$CLIENT_PID"
+	CLIENT_STATUS=$?
+	set -e
+	CLIENT_PID=""
+	echo "could not resolve workload backend PID (psql exit ${CLIENT_STATUS})" >&2
+	exit 1
+fi
+printf 'application_name=%s\nbackend_pid=%s\n' "$APPNAME" "$BACKEND_PID" \
+	> "${RESULT_DIR}/profile-manifest.txt"
+
+set +e
+perf record -F 99 -g -o "${RESULT_DIR}/perf.data" -p "$BACKEND_PID" -- \
+	sleep "$PERF_SECONDS" > "${RESULT_DIR}/perf-record.log" 2>&1
+PERF_STATUS=$?
+wait "$CLIENT_PID"
+CLIENT_STATUS=$?
+set -e
+CLIENT_PID=""
+printf 'perf_exit_code=%s\nquery_exit_code=%s\n' "$PERF_STATUS" "$CLIENT_STATUS" \
+	>> "${RESULT_DIR}/profile-manifest.txt"
+
+perf report --stdio --children --sort=symbol -i "${RESULT_DIR}/perf.data" \
+	> "${RESULT_DIR}/perf-report-children.txt"
+perf report --stdio --no-children --sort=symbol -i "${RESULT_DIR}/perf.data" \
+	> "${RESULT_DIR}/perf-report-symbol.txt"
+perf script -i "${RESULT_DIR}/perf.data" > "${RESULT_DIR}/perf-script.txt"
+
+if [ "$CLIENT_STATUS" -ne 0 ] || ! grep -Eq 'Index Scan using profile_items_cos_idx.*loops=200' \
+	"${RESULT_DIR}/workload.log"; then
+	echo "profiled query failed or did not prove 200 IVFFlat loops" >&2
+	exit 1
+fi
+
+echo "profile: $RESULT_DIR"
