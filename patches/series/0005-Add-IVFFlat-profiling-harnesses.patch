@@ -0,0 +1,152 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+DBNAME="${DBNAME:-ivfflat_test}"
+WORK_MEM="${WORK_MEM:-4MB}"
+PROBES="${PROBES:-1000}"
+REPETITIONS="${REPETITIONS:-5}"
+PROFILE_ITEMS="${PROFILE_ITEMS:-profile_items}"
+PROFILE_QUERIES="${PROFILE_QUERIES:-profile_queries}"
+RESULT_DIR="${RESULT_DIR:-ivfflat_simd_ablation_$(date +%Y%m%d_%H%M%S)}"
+SCALAR_LIBRARY="${SCALAR_LIBRARY:-}"
+VECTORIZED_LIBRARY="${VECTORIZED_LIBRARY:-}"
+ACTIVE_LIBRARY="${ACTIVE_LIBRARY:-$(pg_config --pkglibdir)/vector.so}"
+ALLOW_LIBRARY_SWAP="${ALLOW_LIBRARY_SWAP:-false}"
+
+PSQL=(psql -X -v ON_ERROR_STOP=1 -d "$DBNAME")
+AGGREGATE_OUTPUT="${RESULT_DIR}/aggregate.csv"
+BACKUP_LIBRARY=""
+INITIAL_SHA256=""
+
+cleanup() {
+	if [ -n "$BACKUP_LIBRARY" ] && [ -f "$BACKUP_LIBRARY" ]; then
+		install -m 755 "$BACKUP_LIBRARY" "$ACTIVE_LIBRARY"
+		rm -f "$BACKUP_LIBRARY"
+	fi
+}
+trap cleanup EXIT INT TERM
+
+fail() {
+	echo "$*" >&2
+	exit 2
+}
+
+validate_identifier() {
+	local name="$1"
+	local value="$2"
+
+	[[ "$value" =~ ^[a-zA-Z_][a-zA-Z0-9_]*$ ]] ||
+		fail "${name} must be an unqualified SQL identifier: ${value}"
+}
+
+activate_library() {
+	local source_library="$1"
+	install -m 755 "$source_library" "$ACTIVE_LIBRARY"
+}
+
+run_plan() {
+	local variant="$1"
+	local rep="$2"
+	local source_library="$3"
+	local output_dir="${RESULT_DIR}/${variant}"
+	local output_file="${output_dir}/${variant}_rep${rep}.txt"
+	local system_output="${output_dir}/${variant}_rep${rep}_system.txt"
+	local execution_time temp_read temp_written index_loops active_sha256
+
+	activate_library "$source_library"
+	active_sha256="$(sha256sum "$ACTIVE_LIBRARY" | awk '{ print $1 }')"
+	mkdir -p "$output_dir"
+	{
+		date -Is
+		cat /proc/loadavg
+		ps -eo pid,pcpu,pmem,comm --sort=-pcpu | sed -n '1,12p'
+	} > "$system_output"
+	"${PSQL[@]}" > "$output_file" <<SQL
+LOAD 'vector';
+SET work_mem = '${WORK_MEM}';
+SET max_parallel_workers_per_gather = 0;
+SET enable_seqscan = off;
+SET ivfflat.probes = ${PROBES};
+SET ivfflat.iterative_scan = off;
+EXPLAIN (ANALYZE, BUFFERS, COSTS OFF)
+SELECT count(*)
+FROM ${PROFILE_QUERIES} q
+CROSS JOIN LATERAL (
+	SELECT i.id
+	FROM ${PROFILE_ITEMS} i
+	ORDER BY i.embedding <=> q.embedding
+	LIMIT 10
+) nearest;
+SQL
+
+	execution_time="$(awk '/Execution Time:/ { print $(NF - 1); exit }' "$output_file")"
+	read -r temp_read temp_written < <(
+		awk '
+			/Buffers:.*temp read=/ {
+				for (i = 1; i <= NF; i++) {
+					if ($i ~ /^read=/) { split($i, a, "="); read = a[2] }
+					if ($i ~ /^written=/) { split($i, a, "="); written = a[2] }
+				}
+				exit
+			}
+			END { printf "%d %d\n", read + 0, written + 0 }
+		' "$output_file"
+	)
+	index_loops="$(
+		grep -E 'Index Scan using profile_items_cos_idx.*loops=[0-9]+' "$output_file" |
+			sed -E 's/.*loops=([0-9]+).*/\1/' | head -n 1
+	)"
+
+	if [ -z "$execution_time" ] || [ "${index_loops:-0}" -ne 200 ]; then
+		echo "invalid plan evidence in ${output_file}" >&2
+		exit 1
+	fi
+
+	printf '%s,%s,%s,%s,%s,%s,%s\n' \
+		"$variant" "$rep" "$active_sha256" "$execution_time" "$temp_read" \
+		"$temp_written" "$index_loops" >> "$AGGREGATE_OUTPUT"
+}
+
+[ "$ALLOW_LIBRARY_SWAP" = true ] ||
+	fail "set ALLOW_LIBRARY_SWAP=true after confirming ACTIVE_LIBRARY"
+[ -f "$SCALAR_LIBRARY" ] || fail "SCALAR_LIBRARY does not exist: ${SCALAR_LIBRARY}"
+[ -f "$VECTORIZED_LIBRARY" ] || fail "VECTORIZED_LIBRARY does not exist: ${VECTORIZED_LIBRARY}"
+[ -f "$ACTIVE_LIBRARY" ] || fail "ACTIVE_LIBRARY does not exist: ${ACTIVE_LIBRARY}"
+case "$REPETITIONS" in
+	''|*[!0-9]*) fail "REPETITIONS must be a positive integer: ${REPETITIONS}" ;;
+esac
+[ "$REPETITIONS" -gt 0 ] || fail "REPETITIONS must be greater than zero"
+validate_identifier "PROFILE_ITEMS" "$PROFILE_ITEMS"
+validate_identifier "PROFILE_QUERIES" "$PROFILE_QUERIES"
+
+mkdir -p "$RESULT_DIR"
+BACKUP_LIBRARY="$(mktemp "${ACTIVE_LIBRARY}.simd-ablation.XXXXXX")"
+cp -p "$ACTIVE_LIBRARY" "$BACKUP_LIBRARY"
+INITIAL_SHA256="$(sha256sum "$ACTIVE_LIBRARY" | awk '{ print $1 }')"
+printf '%s\n' 'variant,rep,library_sha256,execution_time_ms,temp_read_blocks,temp_written_blocks,index_loops' \
+	> "$AGGREGATE_OUTPUT"
+printf 'initial_active_library_sha256=%s\n' "$INITIAL_SHA256" > "${RESULT_DIR}/library-manifest.txt"
+sha256sum "$SCALAR_LIBRARY" "$VECTORIZED_LIBRARY" >> "${RESULT_DIR}/library-manifest.txt"
+
+# Alternate both order and implementation so machine drift is paired within each repetition.
+for rep in $(seq 1 "$REPETITIONS"); do
+	if [ $((rep % 2)) -eq 1 ]; then
+		run_plan scalar "$rep" "$SCALAR_LIBRARY"
+		run_plan vectorized "$rep" "$VECTORIZED_LIBRARY"
+	else
+		run_plan vectorized "$rep" "$VECTORIZED_LIBRARY"
+		run_plan scalar "$rep" "$SCALAR_LIBRARY"
+	fi
+done
+
+cleanup
+BACKUP_LIBRARY=""
+RESTORED_SHA256="$(sha256sum "$ACTIVE_LIBRARY" | awk '{ print $1 }')"
+printf 'restored_active_library_sha256=%s\n' "$RESTORED_SHA256" >> "${RESULT_DIR}/library-manifest.txt"
+if [ "$RESTORED_SHA256" != "$INITIAL_SHA256" ]; then
+	echo "active library restoration checksum mismatch" >&2
+	exit 1
+fi
+
+echo "aggregate: $AGGREGATE_OUTPUT"
+echo "library manifest: ${RESULT_DIR}/library-manifest.txt"
