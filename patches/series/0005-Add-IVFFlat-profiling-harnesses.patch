index 0000000000000000000000000000000000000000..b2a010c3a39e468ea92232a9cb6f68d5c282cb8d
--- /dev/null
+++ b/contrib/pgvector/bench/run_ivfflat_rescan_memory.sh
@@ -0,0 +1,256 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
+RESULT_DIR="${RESULT_DIR:-${SCRIPT_DIR}/results}"
+
+DBNAME="${DBNAME:-postgres}"
+CREATE_EXTENSION="${CREATE_EXTENSION:-true}"
+OPENTENBASE_CN_PORT="${OPENTENBASE_CN_PORT:-}"
+ITEM_ROWS="${ITEM_ROWS:-1000}"
+DIMS="${DIMS:-128}"
+RESCANS="${RESCANS:-50000}"
+LISTS="${LISTS:-20}"
+PROBES="${PROBES:-1}"
+SAMPLE_INTERVAL="${SAMPLE_INTERVAL:-0.10}"
+STARTUP_DELAY="${STARTUP_DELAY:-2}"
+RUN_ID="${RUN_ID:-ivfflat_rescan_$(date +%Y%m%d_%H%M%S)}"
+SAMPLES_OUTPUT="${SAMPLES_OUTPUT:-${RESULT_DIR}/${RUN_ID}_rss.csv}"
+SUMMARY_OUTPUT="${SUMMARY_OUTPUT:-${RESULT_DIR}/${RUN_ID}_summary.csv}"
+PLAN_OUTPUT="${PLAN_OUTPUT:-${RESULT_DIR}/${RUN_ID}_plan.txt}"
+SETUP_OUTPUT="${SETUP_OUTPUT:-${RESULT_DIR}/${RUN_ID}_setup.txt}"
+
+TMP_DIR="$(mktemp -d)"
+ITEMS_FILE="${TMP_DIR}/items.csv"
+QUERIES_FILE="${TMP_DIR}/queries.csv"
+PID_FILE="${TMP_DIR}/backend.pid"
+SQL_FILE="${TMP_DIR}/rescan.sql"
+SETUP_SQL_FILE="${TMP_DIR}/setup.sql"
+CLIENT_PID=""
+EXTERNAL_SETUP=false
+SETUP_DONE=false
+
+cleanup() {
+	if [ -n "$CLIENT_PID" ] && kill -0 "$CLIENT_PID" 2>/dev/null; then
+		kill "$CLIENT_PID" 2>/dev/null || true
+	fi
+	if [ "$SETUP_DONE" = true ]; then
+		psql -X -v ON_ERROR_STOP=1 -p "$OPENTENBASE_CN_PORT" -d "$DBNAME" \
+			-c "DROP TABLE IF EXISTS rescan_queries; DROP TABLE IF EXISTS rescan_items;" \
+			>> "$SETUP_OUTPUT" 2>&1 || true
+	fi
+	rm -rf "$TMP_DIR"
+}
+trap cleanup EXIT INT TERM
+
+require_positive_integer() {
+	local name="$1"
+	local value="$2"
+
+	case "$value" in
+		''|*[!0-9]*)
+			echo "${name} must be a positive integer: ${value}" >&2
+			exit 2
+			;;
+	esac
+
+	if [ "$value" -le 0 ]; then
+		echo "${name} must be greater than zero: ${value}" >&2
+		exit 2
+	fi
+}
+
+generate_vectors() {
+	local count="$1"
+	local dim="$2"
+	local seed="$3"
+	local output_file="$4"
+
+	awk -v count="$count" -v dim="$dim" -v seed="$seed" '
+		BEGIN {
+			srand(seed)
+			for (i = 1; i <= count; i++) {
+				printf "%d,\"[", i
+				for (j = 1; j <= dim; j++) {
+					if (j > 1)
+						printf ","
+					printf "%.8f", rand() + 0.000001
+				}
+				printf "]\"\n"
+			}
+		}
+	' > "$output_file"
+}
+
+read_status_kb() {
+	local status_content="$1"
+	local key="$2"
+
+	awk -v key="${key}:" '$1 == key { print $2; found = 1; exit } END { if (!found) print 0 }' \
+		<<< "$status_content"
+}
+
+for setting in \
+	"ITEM_ROWS:$ITEM_ROWS" \
+	"DIMS:$DIMS" \
+	"RESCANS:$RESCANS" \
+	"LISTS:$LISTS" \
+	"PROBES:$PROBES"
+do
+	require_positive_integer "${setting%%:*}" "${setting#*:}"
+done
+
+case "$CREATE_EXTENSION" in
+	true|false)
+		;;
+	*)
+		echo "CREATE_EXTENSION must be true or false: ${CREATE_EXTENSION}" >&2
+		exit 2
+		;;
+esac
+
+if [ -n "$OPENTENBASE_CN_PORT" ]; then
+	require_positive_integer "OPENTENBASE_CN_PORT" "$OPENTENBASE_CN_PORT"
+	EXTERNAL_SETUP=true
+fi
+
+if [ "$LISTS" -gt "$ITEM_ROWS" ]; then
+	echo "LISTS cannot be greater than ITEM_ROWS" >&2
+	exit 2
+fi
+
+mkdir -p "$RESULT_DIR"
+generate_vectors "$ITEM_ROWS" "$DIMS" 17 "$ITEMS_FILE"
+generate_vectors "$RESCANS" "$DIMS" 97 "$QUERIES_FILE"
+chmod 755 "$TMP_DIR"
+chmod 644 "$ITEMS_FILE" "$QUERIES_FILE"
+
+sed \
+	-e "s#__ITEMS_FILE__#${ITEMS_FILE}#g" \
+	-e "s#__QUERIES_FILE__#${QUERIES_FILE}#g" \
+	-e "s#__PID_FILE__#${PID_FILE}#g" \
+	-e "s#__DIMS__#${DIMS}#g" \
+	-e "s#__LISTS__#${LISTS}#g" \
+	-e "s#__PROBES__#${PROBES}#g" \
+	-e "s#__STARTUP_DELAY__#${STARTUP_DELAY}#g" \
+	"${SCRIPT_DIR}/ivfflat_rescan_memory.sql" > "$SQL_FILE"
+
+if [ "$EXTERNAL_SETUP" = true ]; then
+	sed \
+		-e "s#__ITEMS_FILE__#${ITEMS_FILE}#g" \
+		-e "s#__QUERIES_FILE__#${QUERIES_FILE}#g" \
+		-e "s#__DIMS__#${DIMS}#g" \
+		-e "s#__LISTS__#${LISTS}#g" \
+		"${SCRIPT_DIR}/ivfflat_rescan_setup.sql" > "$SETUP_SQL_FILE"
+
+	SETUP_DONE=true
+	psql -X -v ON_ERROR_STOP=1 -p "$OPENTENBASE_CN_PORT" -d "$DBNAME" \
+		-f "$SETUP_SQL_FILE" > "$SETUP_OUTPUT" 2>&1
+fi
+
+psql -X -v ON_ERROR_STOP=1 -v create_extension="$CREATE_EXTENSION" \
+	-v external_setup="$EXTERNAL_SETUP" \
+	-d "$DBNAME" -f "$SQL_FILE" > "$PLAN_OUTPUT" 2>&1 &
+CLIENT_PID=$!
+
+for _ in $(seq 1 300); do
+	if [ -s "$PID_FILE" ]; then
+		break
+	fi
+	if ! kill -0 "$CLIENT_PID" 2>/dev/null; then
+		break
+	fi
+	sleep 0.1
+done
+
+BACKEND_PID="$(awk 'NF { print $1; exit }' "$PID_FILE" 2>/dev/null || true)"
+if ! [[ "$BACKEND_PID" =~ ^[0-9]+$ ]] || [ ! -r "/proc/${BACKEND_PID}/status" ]; then
+	set +e
+	wait "$CLIENT_PID"
+	CLIENT_STATUS=$?
+	set -e
+	CLIENT_PID=""
+	echo "could not resolve the benchmark backend PID (psql exit ${CLIENT_STATUS})" >&2
+	exit 1
+fi
+
+printf '%s\n' "sample,elapsed_ms,backend_pid,vm_rss_kb,rss_anon_kb,vm_size_kb" > "$SAMPLES_OUTPUT"
+START_NS="$(date +%s%N)"
+SAMPLE=0
+
+while kill -0 "$CLIENT_PID" 2>/dev/null && [ -r "/proc/${BACKEND_PID}/status" ]; do
+	if ! STATUS_CONTENT="$(cat "/proc/${BACKEND_PID}/status" 2>/dev/null)"; then
+		break
+	fi
+	NOW_NS="$(date +%s%N)"
+	ELAPSED_MS=$(((NOW_NS - START_NS) / 1000000))
+	VM_RSS="$(read_status_kb "$STATUS_CONTENT" VmRSS)"
+	RSS_ANON="$(read_status_kb "$STATUS_CONTENT" RssAnon)"
+	VM_SIZE="$(read_status_kb "$STATUS_CONTENT" VmSize)"
+	printf '%s,%s,%s,%s,%s,%s\n' \
+		"$SAMPLE" "$ELAPSED_MS" "$BACKEND_PID" "$VM_RSS" "$RSS_ANON" "$VM_SIZE" >> "$SAMPLES_OUTPUT"
+	SAMPLE=$((SAMPLE + 1))
+	sleep "$SAMPLE_INTERVAL"
+done
+
+set +e
+wait "$CLIENT_PID"
+CLIENT_STATUS=$?
+set -e
+CLIENT_PID=""
+
+PLAN_USES_IVFFLAT=false
+if grep -Eq 'Index Scan using rescan_items_ivfflat_idx' "$PLAN_OUTPUT"; then
+	PLAN_USES_IVFFLAT=true
+fi
+
+OBSERVED_INDEX_LOOPS="$(
+	grep -E 'Index Scan using rescan_items_ivfflat_idx.*loops=[0-9]+' "$PLAN_OUTPUT" |
+		sed -E 's/.*loops=([0-9]+).*/\1/' |
+		sort -nr |
+		head -n 1 || true
+)"
+OBSERVED_INDEX_LOOPS="${OBSERVED_INDEX_LOOPS:-0}"
+
+read -r SAMPLE_COUNT RSS_START RSS_PEAK RSS_END RSS_DELTA <<EOF
+$(awk -F, '
+	NR == 2 { start = $4; peak = $4 }
+	NR > 1 {
+		end = $4
+		if ($4 > peak)
+			peak = $4
+		count++
+	}
+	END {
+		if (count == 0)
+			print "0 0 0 0 0"
+		else
+			printf "%d %d %d %d %d\n", count, start, peak, end, end - start
+	}
+' "$SAMPLES_OUTPUT")
+EOF
+
+printf '%s\n' \
+	"run_id,item_rows,dims,rescans,lists,probes,samples,backend_pid,rss_start_kb,rss_peak_kb,rss_end_kb,rss_delta_kb,query_exit_code,plan_uses_ivfflat,observed_index_loops,external_setup,setup_port" \
+	> "$SUMMARY_OUTPUT"
+printf '%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s\n' \
+	"$RUN_ID" "$ITEM_ROWS" "$DIMS" "$RESCANS" "$LISTS" "$PROBES" "$SAMPLE_COUNT" \
+	"$BACKEND_PID" "$RSS_START" "$RSS_PEAK" "$RSS_END" "$RSS_DELTA" "$CLIENT_STATUS" \
+	"$PLAN_USES_IVFFLAT" "$OBSERVED_INDEX_LOOPS" "$EXTERNAL_SETUP" "$OPENTENBASE_CN_PORT" >> "$SUMMARY_OUTPUT"
+
+echo "samples: $SAMPLES_OUTPUT"
+echo "summary: $SUMMARY_OUTPUT"
+echo "plan: $PLAN_OUTPUT"
+if [ "$EXTERNAL_SETUP" = true ]; then
+	echo "setup: $SETUP_OUTPUT"
+fi
+
+if [ "$CLIENT_STATUS" -ne 0 ]; then
+	echo "rescan query failed with exit code ${CLIENT_STATUS}" >&2
+	exit "$CLIENT_STATUS"
+fi
+
+if [ "$PLAN_USES_IVFFLAT" != true ] || [ "$OBSERVED_INDEX_LOOPS" -le 1 ]; then
+	echo "plan did not prove a repeated IVFFlat index rescan" >&2
+	exit 1
+fi
